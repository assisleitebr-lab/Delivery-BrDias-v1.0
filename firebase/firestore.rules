rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function prof(){return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;}
  function admin(){return signed() && prof().role == 'admin' && prof().active == true;}
  function courier(){return signed() && prof().role == 'motoboy' && prof().active == true;}
  function customer(){return signed() && prof().role == 'cliente' && prof().active == true;}
  match /profiles/{uid} {
   allow create: if signed() && request.auth.uid == uid && request.resource.data.role == 'cliente' && request.resource.data.active == true;
   allow read: if signed() && (request.auth.uid == uid || admin());
   allow update: if admin() || (signed() && request.auth.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.active == resource.data.active);
   allow delete: if admin();
  }
  match /categories/{id} {allow read: if resource.data.active == true || admin(); allow write: if admin();}
  match /products/{id} {allow read: if resource.data.available == true || admin(); allow write: if admin();}
  match /orders/{id} {
   allow create: if customer() && request.resource.data.customerId == request.auth.uid && request.resource.data.status == 'recebido';
   allow read: if admin() || (signed() && resource.data.customerId == request.auth.uid) || (courier() && resource.data.motoboyId == request.auth.uid);
   allow update, delete: if admin();
   match /items/{item} {
    allow read: if admin() || (signed() && get(/databases/$(database)/documents/orders/$(id)).data.customerId == request.auth.uid) || (courier() && get(/databases/$(database)/documents/orders/$(id)).data.motoboyId == request.auth.uid);
    allow create: if customer() && get(/databases/$(database)/documents/orders/$(id)).data.customerId == request.auth.uid;
    allow update, delete: if admin();
   }
   match /statusHistory/{entry} {
    allow read: if admin() || (signed() && get(/databases/$(database)/documents/orders/$(id)).data.customerId == request.auth.uid) || (courier() && get(/databases/$(database)/documents/orders/$(id)).data.motoboyId == request.auth.uid);
    allow write: if admin();
   }
  }
 }
}
